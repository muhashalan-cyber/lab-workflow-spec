APP_NAME="CIPHER Lab Workflow"
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_URL=https://labflow.lan
APP_HOSTNAME=labflow.lan
APP_TIMEZONE=UTC              # store UTC; display Asia/Riyadh in the UI layer
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=labflow
DB_USERNAME=labflow
DB_PASSWORD=                  # generate; never commit

# The runtime role. The app, worker and scheduler connect as THIS, not as DB_USERNAME.
# DB_USERNAME above owns the schema and is used only to run migrations; its credentials
# should not be present in the running application's environment. See
# infra/initdb/README.md - audit immutability depends on this separation.
DB_APP_USERNAME=labflow_app
DB_APP_PASSWORD=             # generate; never commit

REDIS_HOST=redis
REDIS_PASSWORD=               # generate; never commit
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true

# Record retention default, in years. Confirm against PR-REC-CTRL-01 before go-live.
LAB_DEFAULT_RETENTION_YEARS=

# Where job folders live, as seen by the people using the system. The application
# stores evidence paths relative to this and never reads the directory.
LAB_JOB_FOLDER_ROOT=
